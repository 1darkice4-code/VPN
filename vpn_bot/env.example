# Токен Telegram бота (получите у @BotFather)
BOT_TOKEN=your_bot_token_here

# Настройки подключения к БД
DB_HOST=db
DB_PORT=5432
DB_NAME=vpn_bot_db
DB_USER=vpn_bot_user
DB_PASSWORD=post123

# Настройки WireGuard сервера
WG_SERVER_ENDPOINT=your_server_ip:51830
WG_SERVER_PUBLIC_KEY=WG_SERVER_PUBLIC_KEY_PLACEHOLDER
WG_CLIENT_DNS=1.1.1.1,8.8.8.8
WG_ALLOWED_IPS=0.0.0.0/0,::/0
WG_SUBNET=10.66.66.0/24

# Настройки wgREST API (для реальной генерации ключей)
WGREST_URL=http://wgrest:8000
WGREST_DEVICE=wg0
USE_WGREST=true

# Режим разработки (пропускать платежи)
DEV_SKIP_PAYMENTS=1

